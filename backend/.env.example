# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---- Tenancy ----
# Tenant code used when a request does not send the X-Tenant-Code header.
DEFAULT_TENANT_CODE=hvp
# IANA timezone used for "today", week boundaries (Mon-Sun) and monthly caps.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ---- Database ----
# Runtime connection: a NON-owner, NON-superuser role so row level security applies.
DATABASE_URL=postgres://hvp_app:hvp_app_pw@localhost:5432/hvp_dev
# Migration connection: owner role (creates tables, triggers, policies).
DATABASE_MIGRATE_URL=postgres://hvp_owner:hvp_owner_pw@localhost:5432/hvp_dev

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10

# ---- Files (evidence photos, avatars) ----
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000

# ---- Background jobs ----
# Set to false to disable the in-process scheduler (e.g. when running several API replicas).
ENABLE_SCHEDULER=true

# ---- Push / OTP providers: console | fcm / console | esms ----
PUSH_PROVIDER=console
OTP_PROVIDER=console
# Required when OTP_PROVIDER=esms (OTP by Zalo ZNS, SMS fallback, for register + forgot password, https://esms.vn)
# ESMS_API_KEY=xxx
# ESMS_SECRET_KEY=xxx
# Brandname and OTP templates must be registered with eSMS first (see otpSmsText in otp.sender.ts)
# ESMS_BRANDNAME=HVP
# OTP goes by Zalo ZNS first and falls back to SMS: Zalo OA linked in eSMS + approved ZNS OTP template (param `otp`)
# ESMS_ZALO_OA_ID=xxx
# ESMS_ZALO_TEMPLATE_ID=xxx
# true: eSMS validates the request without sending or charging
# ESMS_SANDBOX=false
